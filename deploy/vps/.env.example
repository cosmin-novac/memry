# Memry VPS configuration - read by deploy/vps/docker-compose.yml.
# Copy to .env next to the compose file (deploy/install.sh manages this for you
# at /opt/memry/.env and generates the API key automatically).

# Required: bearer token for the REST API / MCP HTTP endpoint.
MEMRY_API_KEY=change-me

# Set to your domain (with a DNS A record pointing at this server) for
# automatic HTTPS via Caddy. Leave unset to serve plain HTTP on port 80.
#MEMRY_DOMAIN=memory.example.com

# Required: a text model for extraction, from OpenAI (default model gpt-6-luna)
# or Anthropic. The server doesn't start without one.
OPENAI_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...

# Optional: set a different extraction model.
#MEMRY_LLM_MODEL=gpt-6-luna

# Required: a decision model for entity identity, name screening, reconcile,
# decay, dates and search re-ranking. "jev" is TypeSafe's System One model,
# which returns calibrated probabilities (https://typesafe.ai).
MEMRY_DECISION_PROVIDER=jev
MEMRY_DECISION_API_KEY=...
# Set "llm" only on purpose: Memry then sends the decision questions to the text
# model. A text model's confidence scores have not been calibrated, so Memry
# merges entities only by fixed rules and you confirm the other merges in Upkeep.
#MEMRY_DECISION_PROVIDER=llm

# Optional: pin providers explicitly. Without these, autodetection keeps the
# whole deployment on ONE provider: OPENAI_API_KEY drives both the LLM and the
# embeddings, because Anthropic has no embeddings API and preferring it would
# split extraction and vectors across two vendors. Anthropic is used only when
# it is the sole key present. Embeddings upgrade from "hash" to "openai" as soon
# as OPENAI_API_KEY exists (run `memry reindex` after an embedding change, or
# pin hash to keep the local embedder).
#MEMRY_LLM_PROVIDER=openai
#MEMRY_EMBEDDING_PROVIDER=hash

# Optional: reasoning effort for models that support it (Anthropic adaptive
# models and gpt-5*): minimal|low|medium|high. Default: low.
#MEMRY_LLM_EFFORT=low

# Optional: multi-tenant keys - see docs/self-hosting.md.
#MEMRY_TENANTS=[{"name":"acme","api_key":"acme-secret"}]

# Optional: enable OAuth so MCP clients (Claude, Cursor, VS Code) can sign in
# as accounts you create with `memry account add`. Set to your public https
# root - scheme + host only, no trailing slash, no /mcp suffix. Leave unset for
# a single-user server. See docs/self-hosting.md#accounts-and-oauth.
#MEMRY_PUBLIC_URL=https://memory.example.com

# Durability scoring (off by default; needs a decision provider): estimates how
# long each memory stays relevant, which forgetting then uses.
#MEMRY_DURABILITY=1
