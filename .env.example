# Copy to .env next to docker-compose.yml.

# Required: bearer token for the REST API and the MCP HTTP endpoint.
# `memry serve` refuses to bind a public interface without one.
MEMRY_API_KEY=change-me

# Optional: LLM extraction. OpenAI covers both extraction and embeddings;
# Anthropic is used when it is the only key present.
#OPENAI_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...
#MEMRY_LLM_MODEL=gpt-5-mini
