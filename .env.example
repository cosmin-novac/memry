# Copy to .env next to docker-compose.yml.

# Required: bearer token for the REST API and the MCP HTTP endpoint.
# `memry serve` refuses to bind a public interface without one.
MEMRY_API_KEY=change-me

# Required: a text model for extraction. With OpenAI, Memry uses the one key for
# extraction and embeddings (default model gpt-6-luna). Memry uses Anthropic only
# when it is the only key present. The server doesn't start without a text model.
OPENAI_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...
#MEMRY_LLM_MODEL=gpt-6-luna

# Required: a decision model for entity identity, name screening, reconcile,
# decay, dates and search re-ranking. "jev" is TypeSafe's System One model,
# which returns calibrated probabilities (https://typesafe.ai).
MEMRY_DECISION_PROVIDER=jev
MEMRY_DECISION_API_KEY=...
# Set "llm" only on purpose: Memry then sends the decision questions to the text
# model above. A text model's confidence scores have not been calibrated, so
# Memry merges entities only by fixed rules and you confirm the other merges in
# Upkeep.
#MEMRY_DECISION_PROVIDER=llm
