# Copy to .env next to docker-compose.yml.

# Required: bearer token for the REST API and the MCP HTTP endpoint.
# `memry serve` refuses to bind a public interface without one.
MEMRY_API_KEY=change-me

# Required: a text model for extraction. OpenAI covers both extraction and
# embeddings (default model gpt-6-luna); Anthropic is used when it is the only
# key present. The server does not start without one.
OPENAI_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...
#MEMRY_LLM_MODEL=gpt-6-luna

# Required: a decision model for entity identity, name screening, reconcile,
# decay, dates and search re-ranking. "jev" is TypeSafe's System One model,
# which answers with calibrated probabilities (https://typesafe.ai).
MEMRY_DECISION_PROVIDER=jev
MEMRY_DECISION_API_KEY=...
# Only on purpose: "llm" lets the text model above decide instead. Its
# confidence is not calibrated, so no entity merges without you.
#MEMRY_DECISION_PROVIDER=llm
